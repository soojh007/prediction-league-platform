# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-random-string-at-least-50-chars
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# =============================================================================
# DATABASE (Defaults to SQLite for local development if unset)
# =============================================================================
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prediction_league

# =============================================================================
# SPORTS DATA FEED CONFIGURATION
# =============================================================================
# Option 1: Managed Feed (Request a token from hello@predictionleague.site)
SPORTMONKS_API_TOKEN=your_token_here

# Option 2: Bring Your Own Key (BYOK)
# FOOTBALL_API_KEY=your_api_football_key_here

# =============================================================================
# EMAIL (Optional - Password resets & Match reminders)
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Prediction League <no-reply@predictionleague.site>
CONTACT_EMAIL=hello@predictionleague.site
